{
  "name": "@fuelfwd/pdfminer",
  "version": "0.1.0+pdfminer.six.20260107",
  "description": "pdfminer.six ported to Rust: the same text and layout as pdfminer.six, from Node",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FuelFwd/pdfminer-rs.git",
    "directory": "crates/pdfminer-node"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "binding.js",
    "binding.d.ts",
    "*.node"
  ],
  "engines": {
    "node": ">= 20"
  },
  "napi": {
    "binaryName": "pdfminer",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --js binding.js --dts binding.d.ts",
    "build:debug": "napi build --platform --js binding.js --dts binding.d.ts",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.8"
  }
}
